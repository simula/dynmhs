# Maintainer: Thomas Dreibholz <dreibh@simula.no>
pkgname=dynmhs
pkgver=0.3.6
pkgrel=1
pkgdesc="Dynamic Multi-Homing Setup (DynMHS)"
url="https://www.nntb.no/~dreibh/dynmhs/"
arch="all"
license="GPL-3.0-or-later"
depends="iproute2"
makedepends="
	boost-dev
	cmake
	g++
	gcc
	ninja
"
subpackages="
	$pkgname-systemd:_systemd:noarch
	$pkgname-bash-completion
	$pkgname-doc
"
source="https://www.nntb.no/~dreibh/dynmhs/download/$pkgname-$pkgver.tar.xz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	cd "$builddir"
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX:PATH=/usr \
		-DCMAKE_INSTALL_SYSCONFDIR:PATH=/etc
	cmake --build build
}

package() {
	cd "$builddir"
	DESTDIR="$pkgdir" cmake --install build
}

_systemd() {
	pkgdesc="Dynamic Multi-Homing Setup (systemd service configuration)"
	depends="$pkgname=$pkgver-r$pkgrel"

	mkdir -p "$subpkgdir"/usr/lib
	mv "$pkgdir"/usr/lib/systemd "$subpkgdir"/usr/lib/
}

sha512sums="
9ac0bfb8dc1bfa3bb2a07ed9d5618390ab765c4252f39c345ca84d0232fff39c0f58b61a27bfb72ef0f87ce0f353c52544cd0f46746b70d232e8d76f9d2f0a94  dynmhs-0.3.6.tar.xz
"
